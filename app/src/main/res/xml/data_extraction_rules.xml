<?xml version="1.0" encoding="utf-8"?>
<!-- Sin copia automática en la nube (Google Drive): la copia se hace a mano desde Ajustes.
     El traspaso directo entre móviles (cable o Wi-Fi al estrenar móvil) sigue permitido. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
